---
import Reveal from "./Reveal.astro";
import SectionHeading from "./SectionHeading.astro";
import Icon from "@/components/ui/Icon.astro";

const items = [
  { icon: "award", title: "Profesional", desc: "Kode bersih, dokumentasi rapi, proses transparan." },
  { icon: "clock", title: "Cepat & Tepat Waktu", desc: "Komitmen pada deadline, milestone yang jelas." },
  { icon: "lifeBuoy", title: "Support After Project", desc: "Maintenance & bantuan teknis pasca-launch." },
  { icon: "slidersHorizontal", title: "Custom Sesuai Kebutuhan", desc: "Solusi dibuat presisi, bukan one-size-fits-all." },
] as const;
---

<section id="why-us" class="relative py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6">
    <SectionHeading
      eyebrow="Why Choose Us"
      description="Karena kami percaya kode yang baik adalah kode yang membantu bisnismu tumbuh."
    >
      Kenapa pilih <span class="text-gradient">YPK?</span>
    </SectionHeading>

    <div class="mt-16 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        items.map((it, i) => (
          <Reveal delay={i * 80}>
            <div class="card-glow card-glow-hover rounded-2xl p-6 h-full">
              <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-linear-to-br from-primary/20 to-secondary/20 border border-primary/20 text-primary mb-4">
                <Icon name={it.icon} size={20} />
              </div>
              <h3 class="font-semibold">{it.title}</h3>
              <p class="mt-2 text-sm text-muted-foreground">{it.desc}</p>
            </div>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
