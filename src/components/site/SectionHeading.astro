---
import Reveal from "./Reveal.astro";

interface Props {
  eyebrow?: string;
  description?: string;
  align?: "left" | "center";
}

const { eyebrow, description, align = "center" } = Astro.props;
---

<div class:list={[align === "center" ? "text-center max-w-2xl mx-auto" : "max-w-2xl"]}>
  {
    eyebrow && (
      <Reveal>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md border border-border bg-surface/60 text-xs uppercase tracking-wider text-primary mb-4">
          {eyebrow}
        </div>
      </Reveal>
    )
  }
  <Reveal delay={80}>
    <h2 class="font-display text-3xl md:text-5xl font-bold tracking-tight">
      <slot />
    </h2>
  </Reveal>
  {
    description && (
      <Reveal delay={160}>
        <p class="mt-4 text-muted-foreground">{description}</p>
      </Reveal>
    )
  }
</div>
